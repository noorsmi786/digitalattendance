# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# ──────────────────────────────────────────────────────────────────────────────
# IMPORTANT: The live database and student photos must NEVER be committed to git.
# They live only on the VPS disk and are preserved across deployments via 
# Docker volumes (./app/data:/app/app/data and ./app/uploads:/app/app/uploads).
# ──────────────────────────────────────────────────────────────────────────────
app/data/attendance.db
app/data/*.db
app/data/*.db-*
app/data/*.db-wal
app/data/*.db-shm
app/uploads/students/*.jpg
app/uploads/students/*.jpeg
app/uploads/students/*.png
app/uploads/students/*.webp
app/uploads/replaced_archive/*
app/uploads/replaced_archive/
app/uploads/exports/*
app/uploads/exports/
*.zip

# Database backups
*.bak
*.bak_*
app/data/*.bak*
app/data/*.pre_fix_*

# Scratch and debug files
scratch/
*.log

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
